# GenAI Winter Smog & Urban Air Quality Assistant - Environment Variables
# Copy this file to .env and insert your real API keys (never commit .env!)

PORT=8000
HOST=0.0.0.0
APP_ENV=development

# Optional LLM API Keys (If left empty, the application seamlessly runs in deterministic offline/demo rule-engine mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default City context
DEFAULT_CITY=Delhi
DEFAULT_AQI_PRESET=Severe
